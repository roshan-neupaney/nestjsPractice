{
    "version": 2,
    "builds": [
      { "src": "dist/main.js", "use": "@vercel/node" }
    ],
    "routes": [
      {
        "src": "/graphql",
        "methods": ["POST", "GET"],
        "dest": "dist/main.js"
      },
      {
        "src": "/(.*)",
        "dest": "dist/main.js"
      }
    ]
  }